            window.addEventListener('attach-media', (e) => attachMediaToHotspot(e.detail));
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            updateHotspotPopupPosition();
            
            // Occlusion Logic for Hotspots
            if(hotspots.length > 0 && modelObject) {
                hotspots.forEach(h => {
                    if(!h.spriteRef) return;
                    
                    // Simple distance/direction check
                    const screenPos = h.spriteRef.position.clone();
                    screenPos.project(camera);
                    
                    raycaster.setFromCamera(screenPos, camera);
                    const intersects = raycaster.intersectObject(modelObject, true);
                    
                    // If model is closer than sprite, fade it
                    if(intersects.length > 0) {
                        const distToModel = intersects[0].distance;
                        const distToSprite = h.spriteRef.position.distanceTo(camera.position);
                        if(distToModel < distToSprite - 0.2) { // Tolerance
                            h.spriteRef.material.opacity = config.hsOpacity * 0.2; // Fade based on master opacity
                        } else {
                            h.spriteRef.material.opacity = config.hsOpacity;
                        }
                    } else {
                        h.spriteRef.material.opacity = config.hsOpacity;
                    }
                });
            }

            renderer.render(scene, camera);
        }

