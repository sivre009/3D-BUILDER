            const btn = document.getElementById(isZip ? 'btn-export-zip' : 'btn-export');
            const originalText = btn.innerText;
            btn.innerText = "Processing...";
            config.camPos = { x: camera.position.x, y: camera.position.y, z: camera.position.z };
            config.camTarget = { x: controls.target.x, y: controls.target.y, z: controls.target.z };
            
            // Prepare Hotspot Data for Export (remove spriteRef circular ref)
            const exportHotspots = hotspots.map(h => ({
                id: h.id,
                position: h.position,
                content: h.content
            }));

            setTimeout(async () => {
                let modelReference = "null";
                let hdriReference = "null";
                if (isZip) {
                    const zip = new JSZip();
                    if(currentModelBase64) {
