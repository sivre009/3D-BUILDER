<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professional 3D Editor & Exporter</title>
    <!-- Tailwind CSS for UI -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- JSZip for Zip Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    
    <!-- Modern Three.js Import Map -->
    <script type="importmap">
        {
            "imports": {
                "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
                "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
            }
        }
    </script>

    <style>
        body { margin: 0; overflow: hidden; background-color: #000; color: #eee; font-family: 'Inter', sans-serif; }
        
        /* Layout Layers */
        #canvas-container { width: 100vw; height: 100vh; position: absolute; top: 0; left: 0; z-index: 0; outline: none; }
        #vignette-overlay { 
            position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1;
            background: radial-gradient(circle, rgba(0,0,0,0) 50%, rgba(0,0,0,0.4) 100%);
        }
        #branding-overlay {
            position: absolute; bottom: 20px; left: 20px; z-index: 5; pointer-events: none;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
            transition: opacity 0.3s ease;
        }
        #branding-overlay.hidden { opacity: 0; }

        #loading-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 50;
            background: #000; display: flex; flex-direction: column; align-items: center; justify-content: center;
            transition: opacity 0.8s ease-out;
        }
        
        /* UI Elements */
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #171717; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 2px; }
        ::-webkit-scrollbar-thumb:hover { background: #555; }

        .disabled-section { opacity: 0.3; pointer-events: none; filter: grayscale(100%); }

        /* Accordion Styles */
        details > summary { list-style: none; cursor: pointer; outline: none; transition: color 0.2s; }
        details > summary::-webkit-details-marker { display: none; }
        details[open] > summary .arrow { transform: rotate(180deg); }
        
        /* Compact Slider Styles */
        .compact-slider-container {
            position: relative;
            height: 28px;
            background-color: #1a1a1a;
            border-radius: 4px;
            overflow: hidden;
            border: 1px solid #333;
            transition: border-color 0.2s;
        }
        .compact-slider-container:hover { border-color: #555; }
        
        /* The visual fill bar */
        .slider-fill {
            position: absolute;
            top: 0; left: 0; bottom: 0;
            background-color: rgba(59, 130, 246, 0.3); /* Blue tint */
            pointer-events: none;
            transition: width 0.05s linear;
        }
        
        /* Text overlay */
        .slider-label {
            position: absolute;
            left: 8px; top: 0; bottom: 0;
            display: flex; align-items: center;
            font-size: 11px; font-weight: 500; color: #d4d4d4;
            pointer-events: none;
            user-select: none;
        }
        .slider-value {
            position: absolute;
            right: 8px; top: 0; bottom: 0;
            display: flex; align-items: center;
            font-size: 11px; font-family: monospace; color: #3b82f6;
            pointer-events: none;
            user-select: none;
        }

        /* The actual invisible input */
        .ghost-input {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            opacity: 0;
            cursor: ew-resize; /* Horizontal resize cursor */
            margin: 0;
        }

        /* Color Input Compact */
        .compact-color {
            display: flex; justify-content: space-between; align-items: center;
            height: 28px; background: #1a1a1a; border-radius: 4px; padding: 0 8px;
            border: 1px solid #333;
        }
        .compact-color input[type="color"] {
            width: 20px; height: 20px; border: none; padding: 0; background: none; cursor: pointer;
        }
        
        /* Spinner */
        .spinner { width: 40px; height: 40px; border: 3px solid rgba(255,255,255,0.3); border-radius: 50%; border-top-color: #fff; animation: spin 1s ease-in-out infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* Sleek Hotspot Popup */
        .hotspot-card {
            position: absolute;
            top: 0; left: 0;
            
            /* Smart Scaling Logic: Max dimension controlled by CSS var */
            max-width: var(--card-scale, 400px);
            max-height: var(--card-scale, 400px);
            width: auto;
            height: auto;
            
            background: rgba(20, 20, 20, 0.85);
            backdrop-filter: blur(12px);
            border: none;
            border-radius: 16px;
            padding: 0;
            color: white;
            z-index: 100;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            display: none;
            transform: translate(-50%, -105%); /* Center bottom anchor with gap */
            opacity: 0;
            transition: opacity 0.2s ease;
            overflow: hidden; /* Clips content to rounded corners */
            
            /* Flex layout to handle content sizing */
            display: flex;
            flex-direction: column;
        }
        .hotspot-card.visible { display: flex; opacity: 1; }
        
        /* Edge-to-edge media with smart containment */
        .hotspot-card img, .hotspot-card video { 
            display: block; 
            margin: 0;
            width: auto;
            height: auto;
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }
        
        /* Container for text to ensure it scrolls if long */
        #card-content {
            display: flex;
            flex-direction: column;
            overflow: auto;
            max-height: 100%;
            width: 100%;
        }

        /* Content padding only for text */
        .hotspot-content-inner {
            padding: 16px;
        }
        .hotspot-content-inner p { 
            font-size: 13px; color: #ddd; line-height: 1.5; margin: 0; font-weight: 300; 
        }
        /* Hide padding if empty */
        .hotspot-content-inner:empty { display: none; }

        /* Floating Close Button */
        .hotspot-close { 
            position: absolute; top: 12px; right: 12px; 
            width: 24px; height: 24px;
            background: rgba(0,0,0,0.4);
            backdrop-filter: blur(4px);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: #fff; font-size: 14px; line-height: 1; 
            transition: background 0.2s;
            z-index: 10;
        }
        .hotspot-close:hover { background: rgba(255,255,255,0.2); }

        /* Custom Cursor for placement */
        .cursor-crosshair { cursor: crosshair !important; }

        /* Hidden File Inputs */
        #media-picker { display: none; }
        #project-load-input { display: none; }
    </style>
</head>
<body>

    <!-- LOADING SCREEN -->
    <div id="loading-overlay">
        <div class="spinner"></div>
    </div>

    <!-- VIGNETTE -->
    <div id="vignette-overlay"></div>

    <!-- BRANDING -->
    <div id="branding-overlay">
        <h1 id="brand-title-display" class="text-2xl font-light text-white tracking-wide">Untitled Project</h1>
        <p id="brand-author-display" class="text-xs text-neutral-400 mt-1 uppercase tracking-widest">By Author</p>
    </div>

    <!-- HOTSPOT INFO CARD (Floating) -->
    <div id="hotspot-card" class="hotspot-card">
        <div class="hotspot-close" id="btn-close-card">×</div>
        <div id="card-content"></div>
    </div>

    <!-- Hidden Media Inputs -->
    <input type="file" id="media-picker" accept="image/*,video/*">
    <input type="file" id="project-load-input" accept=".json,.3dproject">

    <!-- UI SIDEBAR -->
    <div id="sidebar" class="absolute left-0 top-0 h-full w-80 bg-[#0f0f0f] border-r border-[#222] z-10 flex flex-col shadow-2xl">
        
        <!-- Header -->
        <div class="p-4 border-b border-[#222] bg-[#0f0f0f] z-20">
            <h1 class="text-sm font-bold text-neutral-200 tracking-wide flex items-center gap-2">
                <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
                3D STUDIO <span class="text-[10px] text-neutral-600 font-normal">v5.0</span>
            </h1>
        </div>

        <!-- Scrollable Controls -->
        <div class="flex-1 overflow-y-auto p-4 space-y-4">

            <!-- Project Management Section (New) -->
            <details class="group" open>
                <summary class="flex justify-between items-center text-[11px] font-bold text-neutral-500 uppercase tracking-wider mb-2 hover:text-white">
                    Project Management <span class="arrow transition-transform duration-200">▼</span>
                </summary>
                <div class="space-y-2 pl-2 border-l border-[#222]">
                    <div class="grid grid-cols-2 gap-2">
                        <button id="btn-save-project" class="bg-emerald-900/40 hover:bg-emerald-800 text-emerald-100 text-[10px] py-2 rounded border border-emerald-900 transition-colors">
                            Save Project
                        </button>
                        <button id="btn-load-project" class="bg-blue-900/40 hover:bg-blue-800 text-blue-100 text-[10px] py-2 rounded border border-blue-900 transition-colors">
                            Load Project
                        </button>
                    </div>
                </div>
            </details>

            <hr class="border-[#222]">

            <!-- Assets Section -->
            <details class="group" open>
                <summary class="flex justify-between items-center text-[11px] font-bold text-neutral-500 uppercase tracking-wider mb-2 hover:text-white">
                    Assets <span class="arrow transition-transform duration-200">▼</span>
                </summary>
                <div class="space-y-2 pl-2 border-l border-[#222]">
                    <div class="group relative">
                        <input type="file" id="file-input" accept=".glb" class="block w-full text-[10px] text-neutral-400 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:text-[10px] file:font-semibold file:bg-[#222] file:text-neutral-300 hover:file:bg-[#333] cursor-pointer">
                    </div>
                    <div class="group relative flex gap-2">
                        <input type="file" id="hdr-input" accept=".hdr" class="block w-full text-[10px] text-neutral-400 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:text-[10px] file:font-semibold file:bg-[#222] file:text-neutral-300 hover:file:bg-[#333] cursor-pointer">
                        <button id="btn-remove-hdri" class="bg-[#222] hover:bg-red-900/50 text-neutral-400 hover:text-white px-2 rounded text-[10px] transition-colors">✕</button>
                    </div>
                </div>
            </details>

            <!-- Branding Section -->
            <details class="group" open>
                <summary class="flex justify-between items-center text-[11px] font-bold text-neutral-500 uppercase tracking-wider mb-2 hover:text-white">
                    Project Info <span class="arrow transition-transform duration-200">▼</span>
                </summary>
                <div class="space-y-2 pl-2 border-l border-[#222]">
                    <div class="compact-color mb-2">
                        <span class="text-[11px] text-neutral-300">Show Overlay</span>
                        <input type="checkbox" id="branding-visible" checked>
                    </div>
                    <input type="text" id="brand-title-input" value="Untitled Project" placeholder="Project Title" class="w-full bg-[#1a1a1a] text-xs text-white p-2 h-7 rounded border border-[#333] focus:border-blue-600 outline-none placeholder-neutral-600">
                    <input type="text" id="brand-author-input" value="By Author" placeholder="Author Name" class="w-full bg-[#1a1a1a] text-xs text-white p-2 h-7 rounded border border-[#333] focus:border-blue-600 outline-none placeholder-neutral-600">
                </div>
            </details>
            
            <hr class="border-[#222]">

            <!-- HOTSPOTS SECTION -->
            <details class="group" open>
                <summary class="flex justify-between items-center text-[11px] font-bold text-neutral-500 uppercase tracking-wider mb-2 hover:text-white">
                    Interactive Hotspots <span class="arrow transition-transform duration-200">▼</span>
                </summary>
                <div class="space-y-2 pl-2 border-l border-[#222]">
                    
                    <!-- Visual Settings -->
                    <div class="grid grid-cols-2 gap-2 mb-2">
                        <div class="compact-slider-container">
                            <div class="slider-fill" id="fill-hs-size" style="width: 25%"></div>
                            <span class="slider-label">Dot Size</span>
                            <span class="slider-value" id="val-hs-size">0.5</span>
                            <input type="range" id="hs-size" class="ghost-input" min="0.1" max="2.0" step="0.1" value="0.5">
                        </div>
                        <div class="compact-slider-container">
                            <div class="slider-fill" id="fill-hs-opacity" style="width: 80%"></div>
                            <span class="slider-label">Opacity</span>
                            <span class="slider-value" id="val-hs-opacity">0.8</span>
                            <input type="range" id="hs-opacity" class="ghost-input" min="0.1" max="1.0" step="0.1" value="0.8">
                        </div>
                    </div>
                    <div class="compact-slider-container mb-3">
                        <div class="slider-fill" id="fill-hs-popup-scale" style="width: 50%"></div>
                        <span class="slider-label">Popup Scale</span>
                        <span class="slider-value" id="val-hs-popup-scale">400px</span>
                        <input type="range" id="hs-popup-scale" class="ghost-input" min="200" max="800" step="10" value="400">
                    </div>

                    <!-- Placement Toggle -->
                    <button id="btn-toggle-place" class="w-full py-2 px-3 bg-[#222] hover:bg-blue-900/30 text-xs text-neutral-300 rounded border border-[#333] transition-colors flex items-center justify-between">
                        <span>Placement Mode</span>
                        <div id="indicator-place" class="w-2 h-2 rounded-full bg-red-500"></div>
                    </button>
                    <p class="text-[9px] text-neutral-500 italic">Toggle ON, then click model to add hotspot.</p>
                    
                    <!-- Hotspot List -->
                    <div id="hotspot-list-container" class="space-y-2 mt-3">
                        <!-- Dynamic Hotspots will appear here -->
                    </div>
                </div>
            </details>

            <hr class="border-[#222]">

            <!-- Materials Section -->
            <details class="group">
                <summary class="flex justify-between items-center text-[11px] font-bold text-neutral-500 uppercase tracking-wider mb-2 hover:text-white">
                    Materials <span class="arrow transition-transform duration-200">▼</span>
                </summary>
                <div class="space-y-2 pl-2 border-l border-[#222]">
                    
                    <div class="compact-color">
                        <span class="text-[11px] text-neutral-300">Disable Reflections</span>
                        <input type="checkbox" id="mat-disable-reflections">
                    </div>

                    <div id="material-sliders" class="space-y-2">
                        <!-- Roughness -->
                        <div class="compact-slider-container">
                            <div class="slider-fill" id="fill-mat-roughness" style="width: 50%"></div>
                            <span class="slider-label">Roughness</span>
                            <span class="slider-value" id="val-mat-roughness">0.5</span>
                            <input type="range" id="mat-roughness" class="ghost-input" min="0" max="1" step="0.01" value="0.5">
                        </div>

                        <!-- Metalness -->
                        <div class="compact-slider-container">
                            <div class="slider-fill" id="fill-mat-metalness" style="width: 5%"></div>
                            <span class="slider-label">Metalness</span>
                            <span class="slider-value" id="val-mat-metalness">0.05</span>
                            <input type="range" id="mat-metalness" class="ghost-input" min="0" max="1" step="0.01" value="0.05">
                        </div>

                        <!-- Specular -->
                        <div class="compact-slider-container">
                            <div class="slider-fill !bg-green-500/20" id="fill-mat-specular" style="width: 100%"></div>
                            <span class="slider-label text-green-100">Specular</span>
                            <span class="slider-value !text-green-400" id="val-mat-specular">1.0</span>
                            <input type="range" id="mat-specular" class="ghost-input" min="0" max="1" step="0.01" value="1.0">
                        </div>
                    </div>
                </div>
            </details>

            <!-- Edges Section -->
            <details class="group">
                <summary class="flex justify-between items-center text-[11px] font-bold text-neutral-500 uppercase tracking-wider mb-2 hover:text-white">
                    Edge Lines <span class="arrow transition-transform duration-200">▼</span>
                </summary>
                <div class="space-y-2 pl-2 border-l border-[#222]">
                    <div class="compact-color">
                        <span class="text-[11px] text-neutral-300">Show Edges</span>
                        <input type="checkbox" id="edge-visible">
                    </div>
                    
                    <div id="edge-controls" class="space-y-2 disabled-section">
                        <!-- Threshold -->
                        <div class="compact-slider-container">
                            <div class="slider-fill" id="fill-edge-angle" style="width: 15%"></div>
                            <span class="slider-label">Threshold</span>
                            <span class="slider-value" id="val-edge-angle">15°</span>
                            <input type="range" id="edge-angle" class="ghost-input" min="1" max="90" step="1" value="15">
                        </div>

                        <!-- Color -->
                        <div class="compact-color">
                            <span class="text-[11px] text-neutral-300">Edge Color</span>
                            <input type="color" id="edge-color" value="#000000">
                        </div>

                        <!-- Opacity -->
                        <div class="compact-slider-container">
                            <div class="slider-fill" id="fill-edge-opacity" style="width: 50%"></div>
                            <span class="slider-label">Opacity</span>
                            <span class="slider-value" id="val-edge-opacity">0.5</span>
                            <input type="range" id="edge-opacity" class="ghost-input" min="0" max="1" step="0.1" value="0.5">
                        </div>
                    </div>
                </div>
            </details>

            <!-- Lighting Section -->
            <details class="group">
                <summary class="flex justify-between items-center text-[11px] font-bold text-neutral-500 uppercase tracking-wider mb-2 hover:text-white">
                    Lighting <span class="arrow transition-transform duration-200">▼</span>
                </summary>
                <div class="space-y-2 pl-2 border-l border-[#222]">
                    
                    <!-- Sun Toggle -->
                    <div class="compact-color border-l-2 border-l-yellow-600">
                        <span class="text-[11px] text-yellow-500 font-bold uppercase">Sun Light</span>
                        <div class="flex items-center gap-2">
                            <span class="text-[9px] text-neutral-500">SHADOWS</span>
                            <input type="checkbox" id="sun-cast-shadow">
                        </div>
                    </div>

                    <div class="space-y-2 pl-2">
                        <!-- Sun Intensity -->
                        <div class="compact-slider-container">
                            <div class="slider-fill !bg-yellow-500/20" id="fill-sun-intensity" style="width: 30%"></div>
                            <span class="slider-label">Intensity</span>
                            <span class="slider-value !text-yellow-500" id="val-sun-intensity">1.5</span>
                            <input type="range" id="sun-intensity" class="ghost-input" min="0" max="5" step="0.1" value="1.5">
                        </div>
                        
                        <!-- Sun Color -->
                        <div class="compact-color">
                            <span class="text-[11px] text-neutral-300">Sun Color</span>
                            <input type="color" id="sun-color" value="#ffffff">
                        </div>

                        <!-- Position (2 Cols) -->
                        <div class="grid grid-cols-2 gap-2">
                            <div class="compact-slider-container">
                                <div class="slider-fill" id="fill-sun-azimuth" style="width: 12%"></div>
                                <span class="slider-label">Rot</span>
                                <span class="slider-value" id="val-sun-azimuth">45°</span>
                                <input type="range" id="sun-azimuth" class="ghost-input" min="0" max="360" step="1" value="45">
                            </div>
                            <div class="compact-slider-container">
                                <div class="slider-fill" id="fill-sun-elevation" style="width: 66%"></div>
                                <span class="slider-label">Alt</span>
                                <span class="slider-value" id="val-sun-elevation">60°</span>
                                <input type="range" id="sun-elevation" class="ghost-input" min="0" max="90" step="1" value="60">
                            </div>
                        </div>

                        <!-- Shadow Opacity -->
                        <div class="compact-slider-container">
                            <div class="slider-fill" id="fill-shadow-opacity" style="width: 50%"></div>
                            <span class="slider-label">Shad. Opacity</span>
                            <span class="slider-value" id="val-shadow-opacity">0.5</span>
                            <input type="range" id="shadow-opacity" class="ghost-input" min="0" max="1" step="0.05" value="0.5">
                        </div>
                    </div>

                    <!-- Ambient -->
                    <div class="compact-color border-l-2 border-l-blue-600 mt-4">
                        <span class="text-[11px] text-blue-400 font-bold uppercase">Ambient Fill</span>
                        <input type="color" id="amb-color" value="#ffffff">
                    </div>
                    <div class="pl-2">
                        <div class="compact-slider-container">
                            <div class="slider-fill !bg-blue-500/20" id="fill-amb-intensity" style="width: 26%"></div>
                            <span class="slider-label">Intensity</span>
                            <span class="slider-value !text-blue-400" id="val-amb-intensity">0.8</span>
                            <input type="range" id="amb-intensity" class="ghost-input" min="0" max="3" step="0.1" value="0.8">
                        </div>
                    </div>
                </div>
            </details>

            <!-- Shadow Tuning Section -->
            <details class="group">
                <summary class="flex justify-between items-center text-[11px] font-bold text-neutral-500 uppercase tracking-wider mb-2 hover:text-white">
                    Shadow Tuning <span class="arrow transition-transform duration-200">▼</span>
                </summary>
                <div class="space-y-2 pl-2 border-l border-[#222]">
                    <div class="compact-slider-container">
                        <div class="slider-fill" id="fill-shadow-bias" style="width: 45%"></div>
                        <span class="slider-label">Bias Fix</span>
                        <span class="slider-value" id="val-shadow-bias">-0.0005</span>
                        <input type="range" id="shadow-bias" class="ghost-input" min="-0.005" max="0.005" step="0.0001" value="-0.0005">
                    </div>
                    <div class="compact-slider-container">
                        <div class="slider-fill" id="fill-shadow-normal-bias" style="width: 0%"></div>
                        <span class="slider-label">Normal Bias</span>
                        <span class="slider-value" id="val-shadow-normal-bias">0.0</span>
                        <input type="range" id="shadow-normal-bias" class="ghost-input" min="0" max="0.2" step="0.001" value="0.0">
                    </div>
                    <div class="compact-slider-container">
                        <div class="slider-fill" id="fill-ao-intensity" style="width: 20%"></div>
                        <span class="slider-label">AO Strength</span>
                        <span class="slider-value" id="val-ao-intensity">1.0</span>
                        <input type="range" id="ao-intensity" class="ghost-input" min="0" max="5" step="0.1" value="1.0">
                    </div>
                </div>
            </details>

            <!-- Camera Section -->
            <details class="group">
                <summary class="flex justify-between items-center text-[11px] font-bold text-neutral-500 uppercase tracking-wider mb-2 hover:text-white">
                    Camera & View <span class="arrow transition-transform duration-200">▼</span>
                </summary>
                <div class="space-y-2 pl-2 border-l border-[#222]">
                    <div class="compact-slider-container">
                        <div class="slider-fill" id="fill-cam-exposure" style="width: 33%"></div>
                        <span class="slider-label">Exposure</span>
                        <span class="slider-value" id="val-cam-exposure">1.0</span>
                        <input type="range" id="cam-exposure" class="ghost-input" min="0.1" max="3.0" step="0.1" value="1.0">
                    </div>
                    <div class="compact-slider-container">
                        <div class="slider-fill" id="fill-cam-contrast" style="width: 33%"></div>
                        <span class="slider-label">Contrast</span>
                        <span class="slider-value" id="val-cam-contrast">1.0</span>
                        <input type="range" id="cam-contrast" class="ghost-input" min="0.5" max="2.0" step="0.05" value="1.0">
                    </div>
                    <div class="compact-slider-container">
                        <div class="slider-fill" id="fill-cam-saturation" style="width: 50%"></div>
                        <span class="slider-label">Saturation</span>
