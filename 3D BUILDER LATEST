    <!-- 3D VIEWPORT -->
    <div id="canvas-container"></div>

    <!-- Module Script -->
    <script type="module">
        import * as THREE from 'three';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
        import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
        import { RGBELoader } from 'three/addons/loaders/RGBELoader.js';

        // --- GLOBAL VARIABLES ---
        let scene, camera, renderer, controls, sunLight, ambientLight, shadowPlaneMaterial;
        let modelObject = null;
        let currentModelBase64 = null;
        let currentHdriBase64 = null;
        let rotationTimeout;
        let raycaster, pointer;
        
        // Hotspot State
        let hotspots = []; // { id, position: {x,y,z}, content, spriteRef }
        let isPlacementMode = false;
        let activeHotspot = null;
        let targetHotspotIdForMedia = null; 
        let hotspotSpriteMaterial;
        
        // Configuration
        let config = {
            // Updated defaults from request
            bgTop: '#292929', bgBot: '#000000', 
            sunCastShadow: true, // Shadow toggle default
            sunIntensity: 4.1, sunColor: '#ffffff', sunAzimuth: 318, sunElevation: 63,
            ambIntensity: 0.6, ambColor: '#ffffff', 
            shadowBias: -0.0001, normalBias: 0.0, shadowOpacity: 0.5, aoIntensity: 1.0, 
            disableReflections: false, roughness: 0.5, metalness: 0.05, envMapIntensity: 1.0, specularIntensity: 1.0,
            exposure: 1.4, contrast: 0.9, saturation: 0.85,
            autoRotate: false, rotateSpeed: 2.0, damping: 0.05, autoRotateDelay: 2.0,
            projectTitle: "Untitled Project", projectAuthor: "By Author", brandingVisible: true,
            // Edge Settings
            edgeVisible: false, edgeThreshold: 15, edgeColor: "#000000", edgeOpacity: 0.5,
            // Hotspot Settings
            hsSize: 0.5, hsOpacity: 0.8, hsPopupScale: 400
        };

        function init() {
            // Initial UI Sync
            syncUI();

            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 5, 15);

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap; // Optimized Shadows
            renderer.outputEncoding = THREE.SRGBColorSpace; 
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = config.exposure;
            document.getElementById('canvas-container').appendChild(renderer.domElement);

            controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = config.damping;
            controls.enableZoom = true;
            controls.zoomSpeed = 0.8;
            controls.rotateSpeed = 0.5;
            controls.panSpeed = 0.5;
            controls.screenSpacePanning = true;
            controls.autoRotate = config.autoRotate;
            
            // Interaction Delay
            controls.addEventListener('start', () => {
                clearTimeout(rotationTimeout);
                controls.autoRotate = false;
            });
            
            controls.addEventListener('end', () => {
                if (config.autoRotate) {
                    clearTimeout(rotationTimeout);
                    rotationTimeout = setTimeout(() => {
                        controls.autoRotate = true;
                    }, config.autoRotateDelay * 1000);
                }
            });
            controls.addEventListener('change', updateHotspotPopupPosition); // Track popup when moving

            // Raycaster for interactions
            raycaster = new THREE.Raycaster();
            pointer = new THREE.Vector2();

            setupLights();
            setupShadowPlane();
            setupHotspotMaterial();

            window.addEventListener('resize', onWindowResize);
            window.addEventListener('pointerdown', onPointerDown); // Hotspot Interaction
            window.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeHotspotPopup(); }); // ESC Close
            setupUIListeners();
            updateBackground();
            
            // Remove loader when scene is ready (basic simulation)
            setTimeout(() => {
                document.getElementById('loading-overlay').style.opacity = '0';
                setTimeout(() => document.getElementById('loading-overlay').style.display = 'none', 800);
            }, 1000);

            animate();
        }

        // Calculate fill percentage for visual sliders
        function updateSliderVisual(id, val) {
            const el = document.getElementById(id);
            if(!el) return;
            const min = parseFloat(el.min);
            const max = parseFloat(el.max);
            const current = parseFloat(val);
            const percent = ((current - min) / (max - min)) * 100;
            const fillId = `fill-${id}`;
            const fillEl = document.getElementById(fillId);
            if(fillEl) fillEl.style.width = `${percent}%`;
        }

        // Helper to set UI input values to match config defaults on load
        function syncUI() {
            const setVal = (id, val) => {
                const el = document.getElementById(id);
                if (el) {
                    el.value = val;
                    updateSliderVisual(id, val);
                }
            };
            const setChecked = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.checked = val;
            };
            const setTxt = (id, val) => {
                const el = document.getElementById(id); // Usually val-ID
                if (el) el.innerText = val;
            };

            setVal('bg-color-1', config.bgTop);
            setVal('bg-color-2', config.bgBot);
            setVal('sun-intensity', config.sunIntensity);
            setVal('sun-color', config.sunColor);
            setVal('sun-azimuth', config.sunAzimuth);
            setVal('sun-elevation', config.sunElevation);
            setVal('amb-intensity', config.ambIntensity);
            setVal('amb-color', config.ambColor);
            setVal('shadow-bias', config.shadowBias);
            setVal('shadow-normal-bias', config.normalBias);
            setVal('shadow-opacity', config.shadowOpacity);
            setVal('ao-intensity', config.aoIntensity);
            setVal('mat-roughness', config.roughness);
            setVal('mat-metalness', config.metalness);
            setVal('mat-specular', config.specularIntensity);
            setVal('cam-exposure', config.exposure);
            setVal('cam-contrast', config.contrast);
            setVal('cam-saturation', config.saturation);
            setVal('rot-speed', config.rotateSpeed);
            setVal('rot-delay', config.autoRotateDelay);
            setVal('brand-title-input', config.projectTitle);
            setVal('brand-author-input', config.projectAuthor);
            
            // Edge inputs
            setChecked('edge-visible', config.edgeVisible);
            setVal('edge-angle', config.edgeThreshold);
            setVal('edge-color', config.edgeColor);
            setVal('edge-opacity', config.edgeOpacity);
            
            // Hotspot inputs
            setVal('hs-size', config.hsSize);
            setVal('hs-opacity', config.hsOpacity);
            setVal('hs-popup-scale', config.hsPopupScale);
            
            setChecked('mat-disable-reflections', config.disableReflections);
            setChecked('auto-rotate', config.autoRotate);
            setChecked('sun-cast-shadow', config.sunCastShadow); 
            setChecked('branding-visible', config.brandingVisible);
            
            // Labels (Manual sync for init)
            setTxt('val-sun-intensity', config.sunIntensity);
            setTxt('val-sun-azimuth', config.sunAzimuth + '°');
            setTxt('val-sun-elevation', config.sunElevation + '°');
            setTxt('val-amb-intensity', config.ambIntensity);
            setTxt('val-shadow-bias', config.shadowBias);
            setTxt('val-shadow-normal-bias', config.normalBias);
            setTxt('val-shadow-opacity', config.shadowOpacity);
            setTxt('val-ao-intensity', config.aoIntensity);
            setTxt('val-mat-roughness', config.roughness);
            setTxt('val-mat-metalness', config.metalness);
            setTxt('val-mat-specular', config.specularIntensity);
            setTxt('val-cam-exposure', config.exposure);
            setTxt('val-cam-contrast', config.contrast);
            setTxt('val-cam-saturation', config.saturation);
            setTxt('val-rot-speed', config.rotateSpeed);
            setTxt('val-rot-delay', config.autoRotateDelay + 's');
            setTxt('val-edge-angle', config.edgeThreshold + '°');
            setTxt('val-edge-opacity', config.edgeOpacity);
            setTxt('val-hs-size', config.hsSize);
            setTxt('val-hs-opacity', config.hsOpacity);
            setTxt('val-hs-popup-scale', config.hsPopupScale + 'px');
            
            // Branding Text
            setTxt('brand-title-display', config.projectTitle);
            setTxt('brand-author-display', config.projectAuthor);
            updateBrandingVisibility();
            updateHotspotPopupScale();
        }

        function setupLights() {
            ambientLight = new THREE.AmbientLight(config.ambColor, config.ambIntensity);
            scene.add(ambientLight);

            sunLight = new THREE.DirectionalLight(config.sunColor, config.sunIntensity);
            sunLight.castShadow = config.sunCastShadow; 
            sunLight.shadow.mapSize.width = 2048;
            sunLight.shadow.mapSize.height = 2048;
            sunLight.shadow.bias = config.shadowBias;
            sunLight.shadow.normalBias = config.normalBias;
            updateSunPosition();
            scene.add(sunLight);
        }

        function setupShadowPlane() {
            const planeGeometry = new THREE.PlaneGeometry(200, 200);
            shadowPlaneMaterial = new THREE.ShadowMaterial({ opacity: config.shadowOpacity });
            const plane = new THREE.Mesh(planeGeometry, shadowPlaneMaterial);
            plane.rotation.x = -Math.PI / 2;
            plane.position.y = -0.01;
            plane.receiveShadow = true;
            scene.add(plane);
        }

        function setupHotspotMaterial() {
            const canvas = document.createElement('canvas');
            canvas.width = 64; canvas.height = 64;
            const ctx = canvas.getContext('2d');
            ctx.beginPath();
            ctx.arc(32, 32, 28, 0, Math.PI * 2);
            ctx.fillStyle = "rgba(255, 255, 255, 1.0)";
            ctx.fill();
            ctx.lineWidth = 4;
            ctx.strokeStyle = "rgba(0, 0, 0, 0.5)";
            ctx.stroke();
            const texture = new THREE.CanvasTexture(canvas);
            hotspotSpriteMaterial = new THREE.SpriteMaterial({ map: texture, depthTest: false, depthWrite: false });
        }

        function updateSunPosition() {
            const r = 20;
            const phi = THREE.MathUtils.degToRad(90 - config.sunElevation);
            const theta = THREE.MathUtils.degToRad(config.sunAzimuth);
            sunLight.position.set(r * Math.sin(phi) * Math.sin(theta), r * Math.cos(phi), r * Math.sin(phi) * Math.cos(theta));
        }

        function updateLights() {
            sunLight.intensity = parseFloat(config.sunIntensity);
            sunLight.color.set(config.sunColor);
            sunLight.castShadow = config.sunCastShadow; 
            sunLight.shadow.bias = parseFloat(config.shadowBias);
            sunLight.shadow.normalBias = parseFloat(config.normalBias);
            updateSunPosition();
            
            ambientLight.intensity = parseFloat(config.ambIntensity);
            ambientLight.color.set(config.ambColor);
            
            if(shadowPlaneMaterial) {
                shadowPlaneMaterial.opacity = parseFloat(config.shadowOpacity);
            }

            renderer.toneMappingExposure = parseFloat(config.exposure);
        }

        function updateMaterialSettings() {
             if (!modelObject) return;
             const sliders = document.getElementById('material-sliders');
             if(config.disableReflections) sliders.classList.add('disabled-section');
             else sliders.classList.remove('disabled-section');

             modelObject.traverse(function(node) {
                if (node.isMesh && node.material) {
                    node.material.aoMapIntensity = parseFloat(config.aoIntensity);
                    
                    if (config.disableReflections) {
                        node.material.roughness = 1.0;
                        node.material.metalness = 0.0;
                        node.material.envMapIntensity = 0.0;
                        node.material.specularIntensity = 0.0; 
                    } else {
                        node.material.roughness = parseFloat(config.roughness);
                        node.material.metalness = parseFloat(config.metalness);
                        node.material.envMapIntensity = parseFloat(config.envMapIntensity);
                        if(node.material.specularIntensity !== undefined) {
                            node.material.specularIntensity = parseFloat(config.specularIntensity);
                        }
                    }
                    node.material.needsUpdate = true;
                }
             });
        }

        // --- EDGE LOGIC ---
        function updateEdges() {
            if (!modelObject) return;
            const controls = document.getElementById('edge-controls');
            if (config.edgeVisible) controls.classList.remove('disabled-section');
            else controls.classList.add('disabled-section');

            modelObject.traverse(function(node) {
                if (node.isMesh) {
                    const existingEdges = node.children.find(child => child.name === '__edges__');
                    if (!config.edgeVisible) {
                        if (existingEdges) node.remove(existingEdges);
                        return;
                    }
                    if (existingEdges) {
                        existingEdges.material.color.set(config.edgeColor);
                        existingEdges.material.opacity = config.edgeOpacity;
                    } else {
                        const edgesGeom = new THREE.EdgesGeometry(node.geometry, config.edgeThreshold);
                        const edgesMat = new THREE.LineBasicMaterial({ color: config.edgeColor, transparent: true, opacity: config.edgeOpacity });
                        const edges = new THREE.LineSegments(edgesGeom, edgesMat);
                        edges.name = '__edges__';
                        node.add(edges);
                    }
                }
            });
        }
        
        function rebuildEdges() {
            if (!modelObject || !config.edgeVisible) return;
            modelObject.traverse(function(node) {
                if (node.isMesh) {
                    const existingEdges = node.children.find(child => child.name === '__edges__');
                    if(existingEdges) {
                        node.remove(existingEdges);
                        existingEdges.geometry.dispose();
                    }
                    const edgesGeom = new THREE.EdgesGeometry(node.geometry, parseFloat(config.edgeThreshold));
                    const edgesMat = new THREE.LineBasicMaterial({ color: config.edgeColor, transparent: true, opacity: config.edgeOpacity });
                    const edges = new THREE.LineSegments(edgesGeom, edgesMat);
                    edges.name = '__edges__';
                    node.add(edges);
                }
            });
        }

        // --- HOTSPOT LOGIC ---
        function togglePlacementMode() {
            isPlacementMode = !isPlacementMode;
            const btn = document.getElementById('btn-toggle-place');
            const ind = document.getElementById('indicator-place');
            const canvas = document.getElementById('canvas-container');
            
            if (isPlacementMode) {
                btn.classList.add('border-blue-500', 'bg-blue-900/20');
                ind.classList.remove('bg-red-500');
                ind.classList.add('bg-green-500', 'animate-pulse');
                btn.querySelector('span').innerText = "Placement Mode: ON";
                canvas.classList.add('cursor-crosshair');
                // Hide popup if open
                closeHotspotPopup();
            } else {
                btn.classList.remove('border-blue-500', 'bg-blue-900/20');
                ind.classList.add('bg-red-500');
                ind.classList.remove('bg-green-500', 'animate-pulse');
                btn.querySelector('span').innerText = "Placement Mode";
                canvas.classList.remove('cursor-crosshair');
            }
        }

        function createHotspot(position, id = null, content = null) {
            const hId = id || 'hs_' + Date.now();
            const hContent = content || `<div class="hotspot-content-inner"><p>Add content here.</p></div>`;
            
            // Create Visual Sprite
            const sprite = new THREE.Sprite(hotspotSpriteMaterial);
            sprite.position.copy(position);
            sprite.scale.set(config.hsSize, config.hsSize, config.hsSize); 
            sprite.material.opacity = config.hsOpacity;
            sprite.renderOrder = 999;
            sprite.userData = { isHotspot: true, id: hId };
            scene.add(sprite);

            const hotspotData = {
                id: hId,
                position: { x: position.x, y: position.y, z: position.z },
                content: hContent,
                spriteRef: sprite
            };
            
            hotspots.push(hotspotData);
            renderHotspotList();
            
            // Reset Mode if creating new
            if(!id && isPlacementMode) togglePlacementMode();
        }

        function deleteHotspot(id) {
            const index = hotspots.findIndex(h => h.id === id);
            if (index > -1) {
                const h = hotspots[index];
                scene.remove(h.spriteRef);
                hotspots.splice(index, 1);
                renderHotspotList();
                closeHotspotPopup();
            }
        }

        function updateHotspotData(id, value) {
            const h = hotspots.find(h => h.id === id);
            if(h) {
                h.content = value;
                // If popup is open for this one, update it live
                if(activeHotspot === h) {
                    document.getElementById('card-content').innerHTML = value;
                }
            }
        }
        
        function attachMediaToHotspot(id) {
            targetHotspotIdForMedia = id;
            document.getElementById('media-picker').click();
        }

        function handleMediaSelection(event) {
            const file = event.target.files[0];
            if(!file || !targetHotspotIdForMedia) return;
            
            const reader = new FileReader();
            reader.onload = function(e) {
                const result = e.target.result;
                let htmlTag = '';
                if(file.type.startsWith('image/')) {
                    htmlTag = `<img src="${result}" alt="Image">`;
                } else if(file.type.startsWith('video/')) {
                    htmlTag = `<video src="${result}" controls autoplay muted loop></video>`;
                }
                
                // Append to existing content or replace? Let's replace for simplicity as per request "find files i need to link"
                const h = hotspots.find(x => x.id === targetHotspotIdForMedia);
                if(h) {
                    h.content = htmlTag; // Pure media, no text container by default for sleekness
                    renderHotspotList(); // Refresh UI text area
                }
                // Reset
                event.target.value = '';
                targetHotspotIdForMedia = null;
            };
            reader.readAsDataURL(file);
        }

        function renderHotspotList() {
            const container = document.getElementById('hotspot-list-container');
            container.innerHTML = '';
            
            hotspots.forEach((h, i) => {
                const row = document.createElement('div');
                row.className = "bg-[#1a1a1a] p-2 rounded border border-[#333] space-y-2";
                row.innerHTML = `
                    <div class="flex justify-between items-center">
                        <span class="text-[10px] font-bold text-neutral-400">#${i+1}</span>
                        <button class="text-red-500 hover:text-red-400 text-[10px]" onclick="window.dispatchEvent(new CustomEvent('delete-hotspot', {detail: '${h.id}'}))">DELETE</button>
                    </div>
                    <div class="flex gap-2">
                         <textarea class="w-full bg-[#111] text-[10px] text-white p-1 rounded border border-[#333] h-12" placeholder="HTML Content" oninput="window.dispatchEvent(new CustomEvent('update-hotspot', {detail: {id: '${h.id}', val: this.value}}))">${h.content}</textarea>
                         <button class="bg-blue-900/50 hover:bg-blue-700 text-blue-200 text-[10px] px-2 rounded border border-blue-800" title="Attach Image/Video" onclick="window.dispatchEvent(new CustomEvent('attach-media', {detail: '${h.id}'}))">Attach<br>Media</button>
                    </div>
                `;
                container.appendChild(row);
            });
        }
        
        function updateHotspotVisuals() {
            hotspots.forEach(h => {
                if(h.spriteRef) {
                    h.spriteRef.scale.set(config.hsSize, config.hsSize, config.hsSize);
                    h.spriteRef.material.opacity = config.hsOpacity;
                }
            });
        }
        
        function updateHotspotPopupScale() {
             document.documentElement.style.setProperty('--card-scale', config.hsPopupScale + 'px');
        }

        function onPointerDown(event) {
            // Only handle left clicks on canvas
            if(event.target.id !== 'canvas-container' && event.target.tagName !== 'CANVAS') return;
            
            pointer.x = (event.clientX / window.innerWidth) * 2 - 1;
            pointer.y = -(event.clientY / window.innerHeight) * 2 + 1;
            
            raycaster.setFromCamera(pointer, camera);

            if (isPlacementMode) {
                // Raycast against model to place
                if (!modelObject) return;
                const intersects = raycaster.intersectObject(modelObject, true);
                if (intersects.length > 0) {
                    const point = intersects[0].point;
                    // Nudge slightly along normal to prevent clipping
                    point.add(intersects[0].face.normal.multiplyScalar(0.05));
                    createHotspot(point);
                }
            } else {
                // Raycast against sprites to view
                const sprites = hotspots.map(h => h.spriteRef);
                const intersects = raycaster.intersectObjects(sprites, false);
                
                if (intersects.length > 0) {
                    const sprite = intersects[0].object;
                    const hotspot = hotspots.find(h => h.id === sprite.userData.id);
                    if(hotspot) openHotspotPopup(hotspot);
                } else {
                    // CLICKED OUTSIDE: Close popup
                    closeHotspotPopup();
                }
            }
        }

        function openHotspotPopup(hotspot) {
            activeHotspot = hotspot;
            const card = document.getElementById('hotspot-card');
            const content = document.getElementById('card-content');
            
            content.innerHTML = hotspot.content;
            
            card.classList.add('visible');
            updateHotspotPopupPosition();
        }

        function closeHotspotPopup() {
            activeHotspot = null;
            document.getElementById('hotspot-card').classList.remove('visible');
        }

        function updateHotspotPopupPosition() {
            if (!activeHotspot) return;
            const card = document.getElementById('hotspot-card');
            
            // Project 3D position to 2D screen
            const pos = activeHotspot.spriteRef.position.clone();
            pos.project(camera);
            
            const x = (pos.x * 0.5 + 0.5) * window.innerWidth;
            const y = (-(pos.y * 0.5) + 0.5) * window.innerHeight;
            
            card.style.left = `${x}px`;
            card.style.top = `${y}px`;
        }
        
        // --- ASSET LOADING HELPERS ---
        function loadModelFromBase64(base64) {
            return new Promise((resolve) => {
                document.getElementById('loading-overlay').style.display = 'flex';
                document.getElementById('loading-overlay').style.opacity = '1';
                
                // Clear old scene parts
                if (modelObject) scene.remove(modelObject);
                hotspots.forEach(h => scene.remove(h.spriteRef));
                hotspots = [];
                renderHotspotList();
                closeHotspotPopup();

                const bin = window.atob(base64);
                const len = bin.length;
                const bytes = new Uint8Array(len);
                for (let i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);

                const loader = new GLTFLoader();
                loader.parse(bytes.buffer, '', function(gltf) {
                    modelObject = gltf.scene;
                    const box = new THREE.Box3().setFromObject(modelObject);
                    const size = box.getSize(new THREE.Vector3());
                    const maxDim = Math.max(size.x, size.y, size.z);
                    const scaleFactor = 10 / maxDim;
                    modelObject.scale.setScalar(scaleFactor);
                    
                    const newBox = new THREE.Box3().setFromObject(modelObject);
                    const center = newBox.getCenter(new THREE.Vector3());
                    modelObject.position.sub(center);
                    modelObject.position.y -= new THREE.Box3().setFromObject(modelObject).min.y;

                    modelObject.traverse(function(node) {
                        if (node.isMesh) {
                            node.castShadow = true;
                            node.receiveShadow = true;
                            if (!(node.material instanceof THREE.MeshPhysicalMaterial)) {
                                const newMat = new THREE.MeshPhysicalMaterial();
                                THREE.MeshStandardMaterial.prototype.copy.call(newMat, node.material);
                                node.material = newMat;
                            }
                            node.material.shadowSide = THREE.DoubleSide;
                        }
                    });
                    
                    scene.add(modelObject);
                    updateMaterialSettings();
                    
                    const maxSize = 10;
                    camera.near = maxSize / 1000;
                    camera.far = maxSize * 100;
                    camera.updateProjectionMatrix();
                    controls.maxDistance = maxSize * 20;
                    controls.target.set(0, maxSize/4, 0); 
                    camera.position.set(maxSize * 0.8, maxSize * 0.8, maxSize * 1.5);
                    controls.update();

                    const shadowCamSize = maxSize * 1.5;
                    sunLight.shadow.camera.left = -shadowCamSize;
                    sunLight.shadow.camera.right = shadowCamSize;
                    sunLight.shadow.camera.top = shadowCamSize;
                    sunLight.shadow.camera.bottom = -shadowCamSize;
                    sunLight.shadow.camera.near = 0.1;
                    sunLight.shadow.camera.far = maxSize * 5;
                    sunLight.shadow.camera.updateProjectionMatrix();
                    
                    if(config.edgeVisible) rebuildEdges();

                    document.getElementById('loading-overlay').style.opacity = '0';
                    setTimeout(() => document.getElementById('loading-overlay').style.display = 'none', 800);
                    resolve();
                });
            });
        }

        function loadHdriFromBase64(base64) {
            new RGBELoader().load(base64, function(texture) {
                texture.mapping = THREE.EquirectangularReflectionMapping;
                scene.environment = texture;
            });
        }

        // --- HANDLERS ---
        function handleFileSelect(evt) {
            const file = evt.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const arrayBuffer = e.target.result;
                currentModelBase64 = arrayBufferToBase64(arrayBuffer);
                loadModelFromBase64(currentModelBase64);
            };
            reader.readAsArrayBuffer(file);
        }

        function handleHdrSelect(evt) {
            const file = evt.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const dataUrl = e.target.result; 
                currentHdriBase64 = dataUrl;
                loadHdriFromBase64(currentHdriBase64);
            };
            reader.readAsDataURL(file);
        }

        function arrayBufferToBase64(buffer) {
            let binary = '';
            const bytes = new Uint8Array(buffer);
            const len = bytes.byteLength;
            for (let i = 0; i < len; i++) { binary += String.fromCharCode(bytes[i]); }
            return window.btoa(binary);
        }

        // --- SAVE / LOAD SYSTEM ---
        function saveProject() {
            const projectData = {
                version: "5.0",
                timestamp: Date.now(),
                config: config,
                modelBase64: currentModelBase64,
                hdriBase64: currentHdriBase64,
                hotspots: hotspots.map(h => ({ id: h.id, position: h.position, content: h.content }))
            };
            
            const jsonString = JSON.stringify(projectData);
            const blob = new Blob([jsonString], {type: "application/json"});
            const url = URL.createObjectURL(blob);
            
            const a = document.createElement('a');
            a.href = url;
            a.download = (config.projectTitle.replace(/[^a-z0-9]/gi, '_').toLowerCase() || 'untitled') + '.3dproject';
            a.click();
            URL.revokeObjectURL(url);
        }

        function loadProject(evt) {
            const file = evt.target.files[0];
            if (!file) return;
            
            const reader = new FileReader();
            reader.onload = async function(e) {
                try {
                    const data = JSON.parse(e.target.result);
                    
                    // 1. Restore Config
                    if(data.config) {
                        config = { ...config, ...data.config };
                        syncUI(); // Trigger UI updates
                        // Manually trigger updates that syncUI might miss due to direct value setting
                        updateLights(); 
                        updateBackground();
                        updateHotspotVisuals();
                        updateBranding();
                        updateBrandingVisibility();
                        updateHotspotPopupScale();
                    }

                    // 2. Restore Model
                    if(data.modelBase64) {
                        currentModelBase64 = data.modelBase64;
                        await loadModelFromBase64(currentModelBase64);
                    }

                    // 3. Restore HDRI
                    if(data.hdriBase64) {
                        currentHdriBase64 = data.hdriBase64;
                        loadHdriFromBase64(currentHdriBase64);
                    } else {
                        scene.environment = null;
                    }

                    // 4. Restore Hotspots
                    if(data.hotspots) {
                        // Clear already handled by loadModel, but safety check
                        data.hotspots.forEach(h => {
                            createHotspot(new THREE.Vector3(h.position.x, h.position.y, h.position.z), h.id, h.content);
                        });
                    }
                    
                    // Reset input
                    evt.target.value = '';

                } catch(err) {
                    alert("Error loading project file: " + err.message);
                }
            };
            reader.readAsText(file);
        }

