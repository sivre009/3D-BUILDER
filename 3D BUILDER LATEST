                        zip.file("model.glb", currentModelBase64, {base64: true});
                    }
                    if(currentHdriBase64) {
                        hdriReference = '"environment.hdr"';
                        const base64Data = currentHdriBase64.split(',')[1];
                        zip.file("environment.hdr", base64Data, {base64: true});
                    }
                    const htmlContent = generateExportHTML(true, modelReference, hdriReference, exportHotspots);
                    zip.file("index.html", htmlContent);
                    const content = await zip.generateAsync({type:"blob"});
                    const a = document.createElement("a");
                    a.href = URL.createObjectURL(content);
                    a.download = `${config.projectTitle.replace(/[^a-z0-9]/gi, '_').toLowerCase()}_package.zip`;
                    a.click();

                } else {
                    if (currentModelBase64) modelReference = `"${currentModelBase64}"`;
                    if (currentHdriBase64) hdriReference = `"${currentHdriBase64}"`;
                    const htmlContent = generateExportHTML(false, modelReference, hdriReference, exportHotspots);
                    const blob = new Blob([htmlContent], { type: 'text/html' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = '3d_viewer_interactive.html';
                    a.click();
                }
                btn.innerText = originalText;
            }, 500);
        }

